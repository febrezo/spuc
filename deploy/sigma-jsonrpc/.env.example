# Service network
PORT=8080
LOG_LEVEL=INFO

# Auth behavior for /jsonrpc
SIGMA_AUTH_REQUIRED=true
SIGMA_ALLOW_INSECURE_WITHOUT_TOKEN=true
SIGMA_RPC_TOKEN=

# Sigma runtime controls
SIGMA_COMMAND_TIMEOUT=20
MAX_RULE_SIZE_BYTES=131072
SIGMA_DISCOVERY_CACHE_TTL_SECONDS=60

# Optional allowlists (comma-separated)
SIGMA_ALLOWED_BACKENDS=splunk,es-qs,eql,cortexxdr
SIGMA_ALLOWED_PIPELINES=

# Optional binary override
SIGMA_BINARY=sigma
