# Copy this file to `.env` before running `docker compose up --build`.

# Host bind/published port for the web UI.
SPUC_BIND_ADDRESS=127.0.0.1
SPUC_HOST_PORT=8090

# Bootstrap local administrator used by `spuc web`.
SPUC_ADMIN_USER=admin
SPUC_ADMIN_PASSWORD=change_me_with_a_long_random_password

# Optional OAuth bootstrap for the web login screen.
SPUC_WEB_GOOGLE_CLIENT_ID=
SPUC_WEB_GOOGLE_CLIENT_SECRET=
SPUC_WEB_GOOGLE_REDIRECT_URI=
SPUC_WEB_GITHUB_CLIENT_ID=
SPUC_WEB_GITHUB_CLIENT_SECRET=
SPUC_WEB_GITHUB_REDIRECT_URI=

# Optional remote Sigma JSON-RPC service.
SIGMA_RPC_URL=
SPUC_SIGMA_RPC_TOKEN=
